{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/codex/user_prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Classifying Opus-Fable task"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/router.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/opus-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Shell|shell_command|functions.shell_command|apply_patch|functions.apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/codex/pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Shell|shell_command|functions.shell_command|apply_patch|functions.apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/codex/post_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/codex/stop_gate.py\"",
            "timeout": 10,
            "statusMessage": "Reviewing Opus-Fable completion"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/finish-the-work.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
